@model Lab3_26._10.Models.Student

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-controller="Home" asp-action="Create" method="post" class="mt-3">
    @* --- Name --- *@
    <div style="margin-top:7px" class="form-group row">
        <label asp-for="name" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="name" class="form-control" placeholder="Họ tên" />
            <span asp-validation-for="name" class="text-danger"></span>
        </div>
    </div>

    @* --- Email --- *@
    <div style="margin-top:7px" class="form-group row">
        <label asp-for="Email" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Email" class="form-control" placeholder="Email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
    </div>

    @* --- Password --- *@
    <div style="margin-top:7px" class="form-group row">
        <label asp-for="Password" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
    </div>

    @* --- Branch --- *@
    <div style="margin-top:7px" class="form-group row">
        <label asp-for="Branch" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <select asp-for="Branch" class="form-control" asp-items="ViewBag.AllBranchs">
                <option value="">-- Chọn ngành học --</option>
            </select>
            <span asp-validation-for="Branch" class="text-danger"></span>
        </div>
    </div>

    <div style="margin-top:7px" class="form-group row">
        <label asp-for="Gender" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10 d-flex align-items-center">
            @if (ViewBag.AllGenders != null)
            {
                foreach (var gender in ViewBag.AllGenders)
                {
                    <div class="form-check form-check-inline me-3">
                        <input type="radio" class="form-check-input" asp-for="Gender" value="@gender" id="Gender_@gender" />
                        <label class="form-check-label" for="Gender_@gender">@gender</label>
                    </div>
                }
            }
            <span asp-validation-for="Gender" class="text-danger d-block"></span>
        </div>
    </div>
    @* --- IsRegular --- *@
    <div style="margin-top:7px" class="form-group row">
        <label asp-for="IsRegular" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10 d-flex align-items-center">
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="IsRegular" id="IsRegular" />
                <label class="form-check-label" for="IsRegular">Học chính quy</label>
            </div>
            <span asp-validation-for="IsRegular" class="text-danger ms-3"></span>
        </div>
    </div>

    @* --- DateOfBorth --- *@
    <div style="margin-top:7px" class="form-group row">
        <label asp-for="DateOfBorth" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="DateOfBorth" class="form-control" />
            <span asp-validation-for="DateOfBorth" class="text-danger"></span>
        </div>
    </div>

    @* --- Address --- *@
    <div style="margin-top:7px" class="form-group row">
        <label asp-for="Address" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <textarea asp-for="Address" class="form-control" placeholder="Địa chỉ"></textarea>
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>
    </div>

    @* --- Submit Button --- *@
    <div style="margin-top:10px" class="form-group row">
        <div class="col-sm-10 offset-sm-2">
            <button type="submit" class="btn btn-primary">Create</button>
        </div>
    </div>
</form>